# Auth perimeter (spec: docs/superpowers/specs/2026-07-30-auth-perimeter-design.md)
# Browsers -> GitHub OAuth (oauth2-proxy). iOS app + agent API -> bearer lane.
# The portal itself never binds a public port.
{
    email {$ACME_EMAIL}
}

{$ORCHA_DOMAIN} {
    # ── Bearer lane: exact team-token match skips OAuth entirely ──────────
    @bearer header Authorization "Bearer {$ORCHA_TEAM_TOKEN}"
    handle @bearer {
        reverse_proxy portal:8000
    }

    # ── OAuth plumbing (sign-in, callback, auth check) ────────────────────
    handle /oauth2/* {
        reverse_proxy oauth2-proxy:4180 {
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-Uri {uri}
        }
    }

    # ── Everything else: browser traffic behind forward_auth ──────────────
    handle {
        forward_auth oauth2-proxy:4180 {
            uri /oauth2/auth
            header_up X-Real-IP {remote_host}
            copy_headers X-Auth-Request-User X-Auth-Request-Email
            @error status 401
            handle_response @error {
                redir * /oauth2/sign_in?rd={scheme}://{host}{uri}
            }
        }
        reverse_proxy portal:8000
    }
}
