#!/bin/sh
# Orcha runner: always-fresh GitHub auth for the sandboxed `gh` CLI.
#
# The host rotates a 1-hour GitHub App installation token into
# /workspace/.orcha/github-token (deploy/github-token-refresh.sh). This wrapper
# shadows the real /usr/bin/gh via PATH order (/usr/local/bin first) and
# re-reads the token file on EVERY invocation, so even a long resident session
# never holds a stale token. Missing/unreadable file -> GH_TOKEN is empty and
# gh reports its normal unauthenticated error. POSIX sh only; the token is
# never echoed and never appears in argv.
GH_TOKEN="$(cat /workspace/.orcha/github-token 2>/dev/null)"
export GH_TOKEN
exec /usr/bin/gh "$@"
